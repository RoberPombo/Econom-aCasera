{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EconomiaCasera",
  "version": "0.1.0",
  "identifier": "com.economiacasera.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Economía Casera",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Control de gastos e ingresos del hogar",
    "longDescription": "Economía Casera es una aplicación de escritorio para registrar gastos e ingresos, ver resúmenes mensuales y anuales, adjuntar tickets y sincronizar con Google Drive.",
    "publisher": "Economia Casera",
    "homepage": "https://github.com/RoberPombo/Econom-aCasera",
    "copyright": "Copyright © Economia Casera",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/RoberPombo/Econom-aCasera/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzREM5RTlDQUREMkVFQTUKUldTbDd0S3RuSjdjODdKalNUWGtDNk5MemlLQVhqYmpUVDBqN2N5YlN5Q3pXVytvL1VtcGpFQVoK"
    },
    "sql": {
      "preload": [
        "sqlite:economiacasera.db"
      ]
    }
  }
}
